{
  "description": "Attribution policy: block commits carrying AI/tool attribution trailers or footers.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-attribution.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
