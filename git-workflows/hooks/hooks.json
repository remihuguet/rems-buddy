{
  "description": "Branch safety: block commits on main/master and pushes whose destination is main/master; block commits staging narrative comment noise.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-branch.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/guard-comment-noise.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
